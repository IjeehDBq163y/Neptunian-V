-- LAG EFFECT: freeze everyone + jitter for realistic lag
local function applyLagToAll()
    spawn(function()
        for i = 1, 20 do
            for _, plr in pairs(Players:GetPlayers()) do
                if plr.Character then
                    local humanoid = plr.Character:FindFirstChildOfClass("Humanoid")
                    if humanoid then
                        humanoid.WalkSpeed = 0
                        humanoid.JumpPower = 0
                        local rootPart = plr.Character:FindFirstChild("HumanoidRootPart")
                        if rootPart then
                            rootPart.Velocity = Vector3.new(0, 0, 0)
                            rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                        end
                    end
                end
            end
            wait(0.2)
        end
    end)
end

-- SHUTDOWN: instant popup to EVERYONE, full lock, blur + lag
local function shutdownServer()
    -- Freeze everyone immediately (lag effect)
    applyLagToAll()
    
    -- Popup appears instantly to everyone
    for _, plr in pairs(Players:GetPlayers()) do
        createDisconnectScreen(plr, "1001")
    end
    
    -- Extra lag jitter
    spawn(function()
        for i = 1, 10 do
            for _, plr in pairs(Players:GetPlayers()) do
                if plr.Character then
                    local rootPart = plr.Character:FindFirstChild("HumanoidRootPart")
                    if rootPart then
                        rootPart.Velocity = Vector3.new(math.random(-50, 50), math.random(-20, 20), math.random(-50, 50))
                    end
                end
            end
            wait(0.1)
        end
    end)
    
    wait(5)
    for _, plr in pairs(Players:GetPlayers()) do
        plr:Kick("Disconnected: Error Code 1001")
    end
    game:Shutdown()
end

