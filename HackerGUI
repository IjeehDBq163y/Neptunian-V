        while true do
            for i = 0, 1, 0.01 do
                Lighting.ClockTime = 6 + (i * 12)
                Lighting.Brightness = 0.5 + (i * 1.5)
                Lighting.Ambient = Color3.fromRGB(128 + (i * 127), 128 + (i * 127), 128 + (i * 127))
                Lighting.OutdoorAmbient = Color3.fromRGB(128 + (i * 127), 128 + (i * 127), 128 + (i * 127))
                Lighting.ColorShift_Top = Color3.fromRGB(255, 255, 255)
                Lighting.ColorShift_Bottom = Color3.fromRGB(255, 255, 255)
                wait(0.1)
            end
            
            for i = 0, 1, 0.01 do
                Lighting.ClockTime = 18 + (i * 12)
                Lighting.Brightness = 2 - (i * 1.8)
                Lighting.Ambient = Color3.fromRGB(255 - (i * 245), 255 - (i * 245), 255 - (i * 225))
                Lighting.OutdoorAmbient = Color3.fromRGB(255 - (i * 245), 255 - (i * 245), 255 - (i * 225))
                Lighting.ColorShift_Top = Color3.fromRGB(255 - (i * 200), 255 - (i * 200), 255 - (i * 150))
                Lighting.ColorShift_Bottom = Color3.fromRGB(255 - (i * 200), 255 - (i * 200), 255 - (i * 150))
                wait(0.1)
            end
        end
    end)
